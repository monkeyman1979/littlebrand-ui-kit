{
  "name": "littlebrand-ui-kit",
  "version": "0.8.3",
  "description": "Clean, semantic Vue.js UI kit using Pug & SASS. Zero utility classes, CSS Grid-first, fully themeable.",
  "type": "module",
  "files": [
    "dist",
    "src/components",
    "src/styles",
    "src/utils",
    "types",
    "TOKENS.md",
    "reference/v1.json",
    "docs/reference/v1",
    "mcp-server/dist",
    "mcp-server/package.json",
    "mcp-server/README.md"
  ],
  "bin": {
    "littlebrand-mcp": "./mcp-server/dist/index.js"
  },
  "main": "./dist/littlebrand-ui.umd.cjs",
  "module": "./dist/littlebrand-ui.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/littlebrand-ui.js",
      "require": "./dist/littlebrand-ui.umd.cjs"
    },
    "./style.css": {
      "types": "./types/style.d.ts",
      "default": "./dist/littlebrand-ui.css"
    },
    "./dist/littlebrand-ui.css": {
      "types": "./types/style.d.ts",
      "default": "./dist/littlebrand-ui.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config site/vite.config.js",
    "typecheck:site": "vue-tsc --noEmit --project site/tsconfig.json",
    "test:site": "node tests/browser-doc-site.mjs",
    "prebuild": "npm run extract",
    "build": "vite build && npm run build:mcp",
    "preview": "vite preview",
    "lint": "eslint src scripts tests site eslint.config.js vitest.config.js vite.config.js --ext .js,.mjs,.ts,.vue",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json && tsc --noEmit --project tests/fixtures/tsconfig.consumer.json && tsc --noEmit --project tests/fixtures/tsconfig.node-consumer.json",
    "test": "vitest run",
    "reference:generate": "node scripts/generate-reference.js",
    "reference:check": "node scripts/generate-reference.js --check",
    "test:browser": "node tests/browser-theme.mjs && node tests/browser-component-slice.mjs && node tests/browser-overlay-scroll.mjs",
    "test:vue-compat": "node tests/check-vue-source-compat.mjs && node tests/browser-overlay-scroll.mjs",
    "test:mcp": "node tests/mcp-stdio.mjs",
    "extract": "npm run extract:tokens && npm run extract:components && npm run sync:versions",
    "extract:tokens": "node scripts/extract-tokens.js",
    "extract:components": "node scripts/extract-components.js",
    "sync:versions": "node scripts/sync-versions.js",
    "build:mcp": "cd mcp-server && npm install && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monkeyman1979/littlebrand-ui-kit.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui-kit",
    "components",
    "sass",
    "pug",
    "semantic-html",
    "css-grid"
  ],
  "sideEffects": [
    "*.css",
    "*.sass"
  ],
  "author": "Ian Madrigal",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/monkeyman1979/littlebrand-ui-kit/issues"
  },
  "homepage": "https://github.com/monkeyman1979/littlebrand-ui-kit#readme",
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "playwright": "1.64.1",
    "pug": "^3.0.4",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "culori": "^4.0.2",
    "zod": "^4.6.7"
  }
}
