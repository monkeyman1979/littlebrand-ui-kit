{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/index.js", "tests/fixtures/VerifiedSlice.vue"],
  "exclude": ["node_modules", "mcp-server", "dist", "examples"]
}
